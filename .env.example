# Copy to .env (Docker Compose) and to .env.local (npm run dev), then fill in.
# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key (NOT the anon key). Server-side only - never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
